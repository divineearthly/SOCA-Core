#!/usr/bin/env python3
"""
SOCA Agentic CLI - Shared Working Memory Architecture
"""

import sys
import os
sys.path.append(os.path.dirname(os.path.abspath(__file__)))

from runtime.agentic_pipeline import AgenticPipeline

def main():
    print("\n🕉️ SOCA Agentic Pipeline (v6.0 - Shared Memory)")
    print("=" * 50)
    
    pipeline = AgenticPipeline()
    
    if len(sys.argv) < 2:
        print("Usage: soca_agent <query>")
        print("  or:  soca_agent explain <query>")
        sys.exit(1)
    
    query = " ".join(sys.argv[1:])
    
    if query.startswith("explain "):
        query = query[8:]
        print(pipeline.explain(query))
    else:
        result = pipeline.process(query)
        print(f"\n📝 Query: {query}")
        print(f"✅ Answer: {result['answer'][:300]}")
        print(f"📊 Confidence: {result['confidence']:.2f}")
        print(f"📍 District: {result.get('context', {}).get('district', 'Unknown')}")
        print(f"🌾 Intent: {result.get('intent', 'Unknown')}")
        print(f"📚 Sources: {len(result.get('sources', []))}")

if __name__ == "__main__":
    main()
