#!/usr/bin/env python3
"""
SOCA Pipeline CLI - Runs the full reasoning pipeline
"""

import sys
import os
sys.path.append(os.path.dirname(os.path.abspath(__file__)))

from runtime.reasoning_pipeline import ReasoningPipeline

def main():
    print("\n🕉️ SOCA Reasoning Pipeline")
    print("=" * 40)
    
    pipeline = ReasoningPipeline()
    
    if len(sys.argv) < 2:
        print("Usage: soca_pipeline <query>")
        print("  or:  soca_pipeline explain <query>")
        sys.exit(1)
    
    query = " ".join(sys.argv[1:])
    
    if query.startswith("explain "):
        query = query[8:]
        print(pipeline.explain(query))
    else:
        result = pipeline.process(query)
        print(f"\n📝 Query: {query}")
        print(f"✅ Answer: {result['answer'][:200]}")
        print(f"📊 Confidence: {result['confidence']:.2f}")
        print(f"⏱️ Time: {result['elapsed_ms']:.1f}ms")

if __name__ == "__main__":
    main()
